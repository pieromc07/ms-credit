      "item": [
        {
          "name": "Emitir tarjeta personal (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"cardId\", body.id);",
                  "pm.test(\"Limite personal, sin consumo y numero enmascarado\", function () {",
                  "    pm.expect(body.creditLimit).to.eql(5000);",
                  "    pm.expect(body.consumedAmount).to.eql(0);",
                  "    pm.expect(body.availableCredit).to.eql(5000);",
                  "    pm.expect(body.status).to.eql(\"ACTIVE\");",
                  "    pm.expect(body.maskedNumber).to.match(/^\\*\\*\\*\\* \\*\\*\\*\\* \\*\\*\\*\\* \\d{4}$/);",
                  "});"
                ]
              }
            }
