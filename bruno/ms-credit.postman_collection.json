{
  "info": {
    "_postman_id": "5c1f8e2b-7a4d-4b93-9e61-2d8f0a3c7b14",
    "name": "MS Credit",
    "description": "Pruebas de /api/v1/credit-products y /api/v1/credit-cards. Requiere ms-credit en 8082 con config-server (8888) y Mongo (creditdb). ms-credit no valida clientes contra ms-customer, por eso los identificadores de cliente son generados. Ejecutar las carpetas en orden 0 a 2 (el orden importa: la carpeta 1 deja el producto personal PAID antes de emitir tarjetas).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "customerId", "value": "" },
    { "key": "businessCustomerId", "value": "" },
    { "key": "dueDate", "value": "" },
    { "key": "productPersonalId", "value": "" },
    { "key": "productBusinessId", "value": "" },
    { "key": "cardId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Preparacion",
      "item": [
        {
          "name": "Health check (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 30);",
                  "pm.collectionVariables.set(\"dueDate\", d.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set(\"customerId\", \"cust-\" + Math.random().toString(36).slice(2, 10));",
                  "pm.collectionVariables.set(\"businessCustomerId\", \"biz-\" + Math.random().toString(36).slice(2, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    },
