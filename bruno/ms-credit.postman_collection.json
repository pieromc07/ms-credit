                  "pm.collectionVariables.set(\"productPersonalId\", body.id);",
                  "pm.test(\"Estado ACTIVE, saldo igual al monto, no vencido\", function () {",
                  "    pm.expect(body.status).to.eql(\"ACTIVE\");",
